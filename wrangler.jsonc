{
  // MAN CAVE SPORTS BOOK: LIVE DATA MIGRATION, STAGING ONLY.
  // Static artwork bypasses Worker; only explicit /proxy and /migration-api/* use it.
  // Existing controller, Firebase, Xfinity and TV URLs remain unchanged.
  "name": "man-cave-28-page",
  "main": "./cloud-28/cloudflare-live-proxy.mjs",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./cloud-28/cloudflare-static-dist",
    "binding": "ASSETS",
    "run_worker_first": ["/proxy", "/migration-api/*", "/staging/api/*", "/api/board/page1_nfl", "/api/board/page2_nfl", "/api/board/page1_nba", "/api/board/page1_cbb", "/api/board/page2_nba", "/api/board/page3_broncos"]
  }
}
