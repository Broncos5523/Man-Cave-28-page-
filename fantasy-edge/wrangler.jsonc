{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "man-cave-fantasy-cloud",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-18",
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [{"name": "FANTASY_STATE", "class_name": "FantasyState"}]},
  "migrations": [{"tag": "fantasy-sqlite-v1", "new_sqlite_classes": ["FantasyState"]}],
  "triggers": {"crons": ["* * * * *"]},
  "observability": {"enabled": false},
  "vars": {"PUBLIC_BASE_URL": "https://man-cave-fantasy-cloud.broncos5523.workers.dev/"}
}
